NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# Neon / any Postgres URL. For a zero-setup local DB run `npm run db:local`
# and use the URL below (PGlite only supports one connection, hence pool size 1).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/postgres
DATABASE_POOL_SIZE=1

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string-of-32-plus-chars
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed browser origins
CORS_ORIGIN=http://localhost:5173
